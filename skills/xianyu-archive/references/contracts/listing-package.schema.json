{
  "type": "object",
  "properties": {
    "contract": {
      "const": "xianyu.listing-package"
    },
    "schema_version": {
      "const": 1
    },
    "product_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "prepared_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "object",
      "properties": {
        "discovery_batch_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_kind": {
          "enum": [
            "discovery",
            "direct"
          ]
        }
      },
      "required": [
        "discovery_batch_id",
        "candidate_id",
        "input_kind"
      ],
      "additionalProperties": false
    },
    "completeness": {
      "enum": [
        "待采集",
        "待补齐",
        "可上架"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "seller_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+$"
        },
        "seller_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "seller_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "object"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "wish_count": {
              "type": "object",
              "properties": {
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "display": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "precision": {
                  "enum": [
                    "exact",
                    "abbreviated",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "display",
                "precision"
              ],
              "additionalProperties": false
            },
            "views": {
              "type": "object",
              "properties": {
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "display": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "precision": {
                  "enum": [
                    "exact",
                    "abbreviated",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "display",
                "precision"
              ],
              "additionalProperties": false
            },
            "product_sales": {
              "type": "object",
              "properties": {
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "display": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "precision": {
                  "enum": [
                    "exact",
                    "abbreviated",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "display",
                "precision"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "wish_count",
            "views",
            "product_sales"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "seller_id",
        "seller_name",
        "seller_url",
        "url",
        "captured_at",
        "evidence_paths",
        "description",
        "attributes",
        "metrics"
      ],
      "additionalProperties": false
    },
    "listing": {
      "type": "object",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "object"
        },
        "price_fen": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "skus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sku_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "price_fen": {
                "type": "integer",
                "minimum": 0
              },
              "evidence_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sku_id",
              "name",
              "options",
              "price_fen",
              "evidence_path"
            ],
            "additionalProperties": false
          }
        },
        "shipping": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "free",
                "fixed",
                "distance",
                "none",
                null
              ]
            },
            "amount_fen": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "exceptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scope": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "mode",
            "amount_fen",
            "exceptions",
            "scope"
          ],
          "additionalProperties": false
        },
        "service_options": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "local_path": {
                "type": "string",
                "minLength": 1
              },
              "watermark_check": {
                "enum": [
                  "passed",
                  "rejected",
                  "unknown"
                ]
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "capture_kind": {
                "enum": [
                  "original",
                  "screenshot"
                ]
              }
            },
            "required": [
              "source_url",
              "local_path",
              "watermark_check",
              "checked_at",
              "capture_kind"
            ],
            "additionalProperties": false
          }
        },
        "inventory_policy": {
          "enum": [
            "platform_default",
            "fixed_9999"
          ]
        },
        "inventory_quantity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "location_policy": {
          "const": "platform_default"
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "attributes",
        "price_fen",
        "skus",
        "shipping",
        "service_options",
        "images",
        "inventory_policy",
        "inventory_quantity",
        "location_policy"
      ],
      "additionalProperties": false
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "source_value": {},
          "listing_value": {},
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "authorized_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "field",
          "source_value",
          "listing_value",
          "reason",
          "authorized_at"
        ],
        "additionalProperties": false
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "contract",
    "schema_version",
    "product_id",
    "revision",
    "prepared_at",
    "lineage",
    "completeness",
    "source",
    "listing",
    "overrides",
    "missing_fields",
    "conflicts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
